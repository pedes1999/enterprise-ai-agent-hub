<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.enterprisehub</groupId>
        <artifactId>enterprise-ai-agent-hub</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-service</artifactId>
    <packaging>jar</packaging>
    <name>rag-service</name>
    <description>Retrieval-augmented generation: knowledge sources, document chunking, hybrid vector + full-text search, and the retrieval AgentTool</description>

    <!-- Unlike agent-runtime, this module DOES own real persistence (entities
         and Spring Data repositories): GatewayApplication's
         @SpringBootApplication(scanBasePackages = "com.enterprisehub") already
         picks up every com.enterprisehub.* package, so no extra @EntityScan or
         @ComponentScan is needed anywhere for these beans to be found. Flyway
         migrations live under this module's own src/main/resources/db/migration
         too: Flyway's default `classpath:db/migration` location merges
         migrations from every jar on the classpath, so gateway-api applies them
         at startup with zero config changes, and this module's schema stays
         genuinely self-owned. See rag-service's migrations for the version
         numbering (continues gateway-api's own V-sequence, not a fresh one). -->
    <dependencies>
        <dependency>
            <groupId>com.enterprisehub</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
