# Copy to .env (gitignored) before running `docker compose up`.

# Required -- E2B sandbox account key, see agent-runtime/sidecar/README.md.
E2B_API_KEY=your-e2b-api-key-here

# Required -- generate a real one, this placeholder is rejected at startup:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_LOCAL_KEY=

# Recommended -- must be at least 32 bytes (JwtService rejects anything shorter
# at startup). Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional -- only needed for team-invite emails (POST /users). Brevo SMTP relay.
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=
MAIL_FROM_ADDRESS=

# Override only if gateway-api will be reachable at a different host/port
# than http://localhost:8080 from the BROWSER's perspective (e.g. deployed
# behind a real domain) -- see frontend/Dockerfile's comment.
FRONTEND_API_BASE_URL=http://localhost:8080

# Optional -- override the dev-only defaults (postgres/hub_user/password)
# baked into docker-compose.yml. The postgres service's port is published to
# the host (5433), so set real values here for anything beyond local dev.
POSTGRES_PASSWORD=
DB_USERNAME=
DB_PASSWORD=
